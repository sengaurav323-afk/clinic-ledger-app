{
    "hosting":  {
                    "public":  ".",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**",
                                   ".git/**",
                                   "**/.git/**",
                                   ".firebase/**",
                                   "**/.firebase/**",
                                   "README.md",
                                   "SETUP-GUIDE.md",
                                   "firestore.rules",
                                   "**/*.ps1",
                                   "**/*.backup*",
                                   "storage.rules"
                               ],
                    "headers":  [
                                    {
                                        "source":  "**/*.html",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-cache"
                                                        }
                                                    ]
                                    },
                                    {
                                        "source":  "/",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-cache"
                                                        }
                                                    ]
                                    }
                                ]
                },
    "storage":  {
                    "rules":  "storage.rules"
                },
    "firestore":  {
                      "rules":  "firestore.rules"
                  }
}